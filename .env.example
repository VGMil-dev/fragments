# Plantilla: valores vacíos deliberadamente. Copiar a .env local y completar antes de continuar.
# Backend only — NEVER expose with VITE_ prefix
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_PROVIDER_ONLY=
# Set verified maxima for the selected model/provider; live calls require model, provider and both rates.
AI_GATEWAY_MAX_INPUT_USD_PER_MILLION=
AI_GATEWAY_MAX_OUTPUT_USD_PER_MILLION=
GITHUB_TOKEN=
SESSION_SECRET=
AUTH_ENABLED=false
# Non-secret settings
DATABASE_URL=file:./data/fragments.sqlite
PUBLIC_APP_URL=http://localhost:5173
API_PORT=3000

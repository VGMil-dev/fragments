# Plantilla: valores vacíos deliberadamente. Copiar a .env local y completar antes de continuar.
# Backend only — NEVER expose with VITE_ prefix
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_PROVIDER_ONLY=
# Set verified maxima for the selected model/provider; live calls require model, provider and both rates.
AI_GATEWAY_MAX_INPUT_USD_PER_MILLION=
AI_GATEWAY_MAX_OUTPUT_USD_PER_MILLION=
GITHUB_TOKEN=
# GitHub OAuth credentials for student identity. Keep only in backend runtime configuration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TEACHER_TEST_EMAIL=
TEACHER_TEST_PASSWORD=
AUTH_ENABLED=false
# PostgreSQL local. Use long URL-safe values for the local-only roles.
POSTGRES_PASSWORD=change-me-bootstrap
FRAGMENTS_PROD_MIGRATOR_PASSWORD=change-me-prod-migrator
FRAGMENTS_PROD_RUNTIME_PASSWORD=change-me-prod-runtime
FRAGMENTS_PROD_BACKUP_PASSWORD=change-me-prod-backup
FRAGMENTS_TEST_MIGRATOR_PASSWORD=change-me-test-migrator
FRAGMENTS_TEST_RUNTIME_PASSWORD=change-me-test-runtime
FRAGMENTS_TEST_BACKUP_PASSWORD=change-me-test-backup
FRAGMENTS_RESTORE_PASSWORD=change-me-restore
# Host-side tests use localhost; containers use the Docker service name.
DATABASE_URL=postgresql://fragments_test_runtime:change-me-test-runtime@localhost:5432/fragments_test?schema=public
MIGRATION_DATABASE_URL=postgresql://fragments_test_migrator:change-me-test-migrator@localhost:5432/fragments_test?schema=public
DATABASE_URL_DOCKER=postgresql://fragments_test_runtime:change-me-test-runtime@postgres:5432/fragments_test?schema=public
MIGRATION_DATABASE_URL_DOCKER=postgresql://fragments_test_migrator:change-me-test-migrator@postgres:5432/fragments_test?schema=public
# Non-secret settings
PUBLIC_APP_URL=http://localhost:5173
API_PORT=3000

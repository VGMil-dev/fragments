{
  "name": "@fragments/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "provision:teacher": "node --env-file=../../.env --import tsx src/auth/provision-better-auth-teacher.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fragments/contracts": "workspace:*",
    "ai": "7.0.163",
    "repomix": "1.18.1",
    "better-auth": "1.7.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

# Copiar a .env.backup. El usuario de backup solo puede leer tablas.
BACKUP_PROD_DATABASE_URL=postgresql://fragments_prod_backup:CAMBIAR@postgres:5432/fragments_prod
BACKUP_TEST_DATABASE_URL=postgresql://fragments_test_backup:CAMBIAR@postgres:5432/fragments_test
BACKUP_DIRECTORY=/backups
RETENTION_DAYS=14

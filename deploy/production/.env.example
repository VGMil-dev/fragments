# Copiar como .env en el directorio de despliegue. Nunca añadir secretos a Git.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_PROVIDER_ONLY=
AI_GATEWAY_MAX_INPUT_USD_PER_MILLION=
AI_GATEWAY_MAX_OUTPUT_USD_PER_MILLION=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://fragments.example.invalid
PUBLIC_APP_URL=https://fragments.example.invalid
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Secreto solo del contenedor API. No usar prefijo VITE_.
RESEND_API_KEY=
# Remitente en un dominio verificado por Resend, por ejemplo Fragments <noreply@fragments.gavanti.org>.
RESEND_FROM_EMAIL=

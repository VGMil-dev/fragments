[Unit]
Description=Aplica un paquete verificado de Fragments
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=FRAGMENTS_RELEASE_AGENT_CONFIG=/etc/fragments-release-agent.json
ExecStart=/usr/bin/python3 /usr/local/libexec/fragments-release-agent.py --apply-queue
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/fragments-release-agent.json /opt/fragments/deploy/production/docker-compose.yml /opt/fragments/deploy/production/.env
ReadWritePaths=/var/lib/fragments-release /var/spool/fragments-release-requests /var/run/docker.sock
TimeoutStartSec=20min

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "env": ["FRAGMENTS_RELEASE_TAG", "FRAGMENTS_RELEASE_SHA"],
      "outputs": ["dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "test": { "dependsOn": ["^build", "prisma:generate"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build", "prisma:generate"] },
    "prisma:generate": { "outputs": ["src/generated/prisma/**"] }
  }
}
